{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kerub",
  "version": "0.2.0",
  "identifier": "local.kerub",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "client",
        "title": "Kerub",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0c0c0e",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://assets.playnccdn.com https://profileimg.plaync.com https://*.playnccdn.com https://shugoggassets.blob.core.windows.net; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
